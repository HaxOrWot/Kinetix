// Kinetix: Vector SMIL & CSS Keyframe Animated SVG Exporter

pub class SvgAnimator {
    pub width: i64
    pub height: i64
    pub elements: List<str>

    init(w: i64, h: i64) {
        self.width = w
        self.height = h
        self.elements = List<str>()
    }

    pub fn add_animated_circle(cx: i64, cy: i64, r: i64, fill: str, attr: str, from_v: str, to_v: str, dur_sec: f64) {
        let dur_str = (dur_sec as str) + "s"
        let elem = "  <circle cx=\"" + (cx as str) + "\" cy=\"" + (cy as str) + "\" r=\"" + (r as str) + "\" fill=\"" + fill + "\">\n" +
                   "    <animate attributeName=\"" + attr + "\" from=\"" + from_v + "\" to=\"" + to_v + "\" dur=\"" + dur_str + "\" repeatCount=\"indefinite\" />\n" +
                   "  </circle>"
        self.elements.push(elem)
    }

    pub fn add_animated_rect(x: i64, y: i64, w: i64, h: i64, fill: str, attr: str, from_v: str, to_v: str, dur_sec: f64) {
        let dur_str = (dur_sec as str) + "s"
        let elem = "  <rect x=\"" + (x as str) + "\" y=\"" + (y as str) + "\" width=\"" + (w as str) + "\" height=\"" + (h as str) + "\" fill=\"" + fill + "\">\n" +
                   "    <animate attributeName=\"" + attr + "\" from=\"" + from_v + "\" to=\"" + to_v + "\" dur=\"" + dur_str + "\" repeatCount=\"indefinite\" />\n" +
                   "  </rect>"
        self.elements.push(elem)
    }

    pub fn add_animated_text(x: i64, y: i64, text: str, fill: str, font_size: i64, attr: str, from_v: str, to_v: str, dur_sec: f64) {
        let dur_str = (dur_sec as str) + "s"
        let elem = "  <text x=\"" + (x as str) + "\" y=\"" + (y as str) + "\" fill=\"" + fill + "\" font-size=\"" + (font_size as str) + "px\" font-family=\"sans-serif\">\n" +
                   "    " + text + "\n" +
                   "    <animate attributeName=\"" + attr + "\" from=\"" + from_v + "\" to=\"" + to_v + "\" dur=\"" + dur_str + "\" repeatCount=\"indefinite\" />\n" +
                   "  </text>"
        self.elements.push(elem)
    }

    pub fn export_svg() -> str {
        let bb = ByteBuffer()
        let w_str = self.width as str
        let h_str = self.height as str
        bb.write_str("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + w_str + " " + h_str + "\" width=\"" + w_str + "\" height=\"" + h_str + "\">\n")
        bb.write_str("  <rect width=\"100%\" height=\"100%\" fill=\"#111116\" />\n")

        mut i = 0
        while i < self.elements.len() {
            bb.write_str(self.elements.get(i) + "\n")
            i = i + 1
        }
        bb.write_str("</svg>\n")

        let s = bb.to_str()
        bb.free()
        return s
    }

    pub fn save_svg_file(path: str) -> bool {
        let content = self.export_svg()
        File.write_string(path, content)
        return File.exists(path)
    }
}
