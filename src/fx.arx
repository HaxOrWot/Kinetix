// Kinetix: Text & Visual Animation FX

fn kinetix_esc_fx() -> str {
    let bb = ByteBuffer()
    bb.write_u8(27)
    let s = bb.to_str()
    bb.free()
    return s
}

pub fn typewriter(text: str, progress: f64) -> str {
    mut p = progress
    if p < 0.0 { p = 0.0 }
    if p > 1.0 { p = 1.0 }

    let count = (p * (text.len() as f64)) as i64
    if count <= 0 { return "" }
    if count >= text.len() { return text }
    return text.slice(0, count)
}

pub fn shimmer(text: str, phase: f64) -> str {
    let bb = ByteBuffer()
    let e = kinetix_esc_fx()
    let n = text.len()

    mut i = 0
    while i < n {
        let ch = text.slice(i, i + 1)
        let pos = (i as f64) / (n as f64)
        mut diff = pos - phase
        if diff < 0.0 { diff = 0.0 - diff }

        // Highlight center of shimmer wave
        mut intensity = 120
        if diff < 0.25 {
            intensity = 255 - ((diff / 0.25) * 135.0) as i64
        }

        bb.write_str(e + "[38;2;" + (intensity as str) + ";" + (intensity as str) + ";255m")
        bb.write_str(ch)
        i = i + 1
    }
    bb.write_str(e + "[0m")
    let res = bb.to_str()
    bb.free()
    return res
}

pub fn wave_text(text: str, phase: f64) -> str {
    let bb = ByteBuffer()
    let e = kinetix_esc_fx()
    let n = text.len()

    mut i = 0
    while i < n {
        let ch = text.slice(i, i + 1)
        let wave_val = (i as f64) * 0.4 + phase
        let r = 50 + (((wave_val * 40.0) as i64) % 180)
        let g = 180
        let b = 255 - r

        bb.write_str(e + "[38;2;" + (r as str) + ";" + (g as str) + ";" + (b as str) + "m")
        bb.write_str(ch)
        i = i + 1
    }
    bb.write_str(e + "[0m")
    let res = bb.to_str()
    bb.free()
    return res
}
