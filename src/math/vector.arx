// Kinetix: 2D Kinematic Vector & Motion Math

pub class Vec2 {
    pub x: f64
    pub y: f64

    init(x: f64, y: f64) {
        self.x = x
        self.y = y
    }

    pub fn add(o: Vec2) -> Vec2 {
        return Vec2(self.x + o.x, self.y + o.y)
    }

    pub fn sub(o: Vec2) -> Vec2 {
        return Vec2(self.x - o.x, self.y - o.y)
    }

    pub fn scale(s: f64) -> Vec2 {
        return Vec2(self.x * s, self.y * s)
    }

    pub fn length_sq() -> f64 {
        return self.x * self.x + self.y * self.y
    }

    pub fn length() -> f64 {
        // Fast square root approximation
        let val = self.length_sq()
        if val <= 0.0 { return 0.0 }
        mut root = val / 2.0
        mut iter = 0
        while iter < 6 {
            root = 0.5 * (root + val / root)
            iter = iter + 1
        }
        return root
    }

    pub fn distance(o: Vec2) -> f64 {
        let dx = self.x - o.x
        let dy = self.y - o.y
        let v = Vec2(dx, dy)
        return v.length()
    }

    pub fn normalize() -> Vec2 {
        let len = self.length()
        if len <= 0.000001 {
            return Vec2(0.0, 0.0)
        }
        return Vec2(self.x / len, self.y / len)
    }

    pub fn lerp(target: Vec2, t: f64) -> Vec2 {
        let lx = self.x + (target.x - self.x) * t
        let ly = self.y + (target.y - self.y) * t
        return Vec2(lx, ly)
    }
}
